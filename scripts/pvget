#!/usr/bin/env python3
import os
import sys

from p4p.client.thread import Context


def main() -> int:
    if len(sys.argv) < 2:
        print("Usage: pvget PV [PV ...]", file=sys.stderr)
        return 2

    # Defaults target the local PVA proxy used with Docker Desktop on macOS.
    conf = {
        "EPICS_PVA_AUTO_ADDR_LIST": os.environ.get("EPICS_PVA_AUTO_ADDR_LIST", "NO"),
        "EPICS_PVA_ADDR_LIST": os.environ.get("EPICS_PVA_ADDR_LIST", "127.0.0.1"),
        "EPICS_PVA_SERVER_PORT": os.environ.get("EPICS_PVA_SERVER_PORT", "5078"),
        "EPICS_PVA_BROADCAST_PORT": os.environ.get("EPICS_PVA_BROADCAST_PORT", "5079"),
    }
    ctx = Context("pva", conf=conf)
    for name in sys.argv[1:]:
        value = ctx.get(name)
        print(f"{name} {value}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
